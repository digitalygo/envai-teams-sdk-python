  "downloadArtifact": {
    "method": "GET",
    "path": "/artifacts/download",
    "params": [
      {
        "name": "generation",
        "in": "query",
        "required": true,
        "description": "Opaque generation id `igr_<ulid>`. The value is covered by the signature.\n",
        "schema": {
          "type": "string",
          "pattern": "^igr_[0-9A-Za-z]{26}$",
          "example": "igr_01ARZ3NDEKTSV4RRFFQ69G5FAV"
        }
      },
      {
        "name": "artifact",
        "in": "query",
        "required": true,
        "description": "Opaque artifact id `art_<ulid>`. The value is covered by the signature.\n",
        "schema": {
          "type": "string",
          "pattern": "^art_[0-9A-Za-z]{26}$",
          "example": "art_01ARZ3NDEKTSV4RRFFQ69G5FAV"
        }
      },
      {
        "name": "expires",
        "in": "query",
        "required": false,
        "description": "Signed URL expiration timestamp, never beyond the generation deadline.\n",
        "schema": {
          "type": "integer",
          "format": "int64",
          "example": 1786320000
        }
      },
      {
        "name": "signature",
        "in": "query",
        "required": true,
        "description": "HMAC signature of the relative URL",
        "schema": {
          "type": "string",
          "example": "6f8d2c4a9b1e5f7a3c8d0e2b4a6c8e0f"
        }
      }
    ],
    "request": null,
    "media": null,
    "request_required": false,
    "response": {
      "type": "string",
      "format": "binary"
    },
    "response_type": "bytes",
    "unwrap": false,
    "auth": false,
    "stream": false,
    "public": true
  },
  "handleProviderWebhook": {
    "method": "POST",
    "path": "/webhooks/providers/{provider}",
    "params": [
      {
        "name": "provider",
        "in": "path",
        "required": true,
        "description": "Provider receiving the webhook",
        "schema": {
          "type": "string",
          "enum": [
            "replicate",
            "vertex",
            "fal",
            "openai",
            "black-forest-labs",
            "recraft",
            "byteplus"
          ],
          "example": "replicate"
        }
      },
      {
        "name": "callback_token",
        "in": "query",
        "required": false,
        "description": "Optional attempt callback token. When present it must match the callback token of an attempt for the provider, with fallback to provider job id and provider request id lookup.\n",
        "schema": {
          "type": "string",
          "example": "0192f3a4-6b1c-4a3e-8f2d-5c9b1a2d3e4f"
        }
      },
      {
        "name": "webhook-id",
        "in": "header",
        "required": false,
        "description": "Replicate webhook event id, sent as plain value for signature verification",
        "schema": {
          "type": "string",
          "example": "msg_01j5abcdefghjkmnpqrstvwxyz"
        }
      },
      {
        "name": "webhook-timestamp",
        "in": "header",
        "required": false,
        "description": "Replicate webhook event timestamp, unix seconds within the tolerance window",
        "schema": {
          "type": "string",
          "example": "1786320000"
        }
      },
      {
        "name": "webhook-signature",
        "in": "header",
        "required": false,
        "description": "Replicate webhook HMAC signature over `webhook-id.webhook-timestamp.body`",
        "schema": {
          "type": "string",
          "example": "v1,abc123def456ghi789"
        }
      },
      {
        "name": "X-Fal-Webhook-Request-Id",
        "in": "header",
        "required": false,
        "description": "Fal webhook request id",
        "schema": {
          "type": "string",
          "example": "req_01j5abcdefghjkmnpqrstvwxyz"
        }
      },
      {
        "name": "X-Fal-Webhook-User-Id",
        "in": "header",
        "required": false,
        "description": "Fal webhook user id",
        "schema": {
          "type": "string",
          "example": "usr_01j5abcdefghjkmnpqrstvwxyz"
        }
      },
      {
        "name": "X-Fal-Webhook-Timestamp",
        "in": "header",
        "required": false,
        "description": "Fal webhook timestamp",
        "schema": {
          "type": "string",
          "example": "1786320000"
        }
      },
      {
        "name": "X-Fal-Webhook-Signature",
        "in": "header",
        "required": false,
        "description": "Fal webhook signature",
        "schema": {
          "type": "string",
          "example": "abc123def456"
        }
      },
      {
        "name": "X-BFL-Signature",
        "in": "header",
        "required": false,
        "description": "Black Forest Labs webhook signature",
        "schema": {
          "type": "string",
          "example": "abc123def456"
        }
      }
    ],
    "request": {
      "$ref": "#/components/schemas/ProviderWebhookPayload"
    },
    "media": "application/json",
    "request_required": false,
    "response": {
      "$ref": "#/components/schemas/WebhookOk"
    },
    "response_type": "WebhookOk",
    "unwrap": false,
    "auth": false,
    "stream": false,
    "public": false
  }
}
