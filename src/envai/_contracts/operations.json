{
  "sendChatMessage": {
    "method": "POST",
    "path": "/chats/{chat_id}/messages",
    "params": [
      {
        "name": "chat_id",
        "in": "path",
        "required": true,
        "description": "Chat id `cht_<ulid>`, 30 characters",
        "schema": {
          "type": "string",
          "pattern": "^[cC][hH][tT]_[0-7][0-9a-hjkmnp-tv-zA-HJKMNP-TV-Z]{25}$",
          "example": "cht_01j5abcdefghjkmnpqrstvwxyz"
        }
      }
    ],
    "request": {
      "$ref": "#/components/schemas/ChatMessageRequest"
    },
    "media": "application/json",
    "request_required": true,
    "response": {
      "$ref": "#/components/schemas/ChatMessageAccepted"
    },
    "response_type": "ChatMessageAccepted",
    "unwrap": false,
    "auth": true,
    "stream": false,
    "public": true
  },
  "streamChatEvents": {
    "method": "GET",
    "path": "/chats/{chat_id}/events",
    "params": [
      {
        "name": "chat_id",
        "in": "path",
        "required": true,
        "description": "Chat id `cht_<ulid>`, 30 characters",
        "schema": {
          "type": "string",
          "pattern": "^[cC][hH][tT]_[0-7][0-9a-hjkmnp-tv-zA-HJKMNP-TV-Z]{25}$",
          "example": "cht_01j5abcdefghjkmnpqrstvwxyz"
        }
      },
      {
        "name": "after",
        "in": "query",
        "required": false,
        "description": "Replay every retained event strictly after this sequence number. The cursor is meaningful only inside the resident runtime's bounded in-memory replay window; eviction or restart resets the sequence without an epoch or cursor-expired signal.\n",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "example": 42
        }
      }
    ],
    "request": null,
    "media": null,
    "request_required": false,
    "response": {
      "type": "string",
      "description": "SSE frames whose `data` field contains one ATP event envelope"
    },
    "response_type": "bytes",
    "unwrap": false,
    "auth": true,
    "stream": true,
    "public": true
  },
